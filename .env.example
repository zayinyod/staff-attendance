# Django の秘密鍵。環境ごとに固有の値を設定する
SECRET_KEY="your-secret-key-here"

# デバッグモード。本番環境では False を設定する
DEBUG=True

# リクエストを許可するホスト名。カンマ区切りで指定する
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS を許可するオリジン。カンマ区切りで指定する
CORS_ALLOWED_ORIGINS=http://localhost:3000

# SQLite の DB とバックアップの配置先。相対パスはリポジトリのルートを起点とする
# DB_PATH=staff_attendance/data/db.sqlite3
# DB_BACKUP_DIR=backups/db
